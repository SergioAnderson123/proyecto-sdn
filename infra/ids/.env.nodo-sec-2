# Valores reales de node-sec-2 (docs/Table_IP_Ports_VNRT.pdf, docs/topology.jpeg). up.sh la copia sola a .env si no existe .env.
SENSOR=nodo-sec-2
IDS_IFACES=ens4                   # unica NIC de espejo de este sensor, hacia sw-core-2 (ens3 es gestion, ens5 va a switch-borde)

ONOS_USER=onos
ONOS_PASS=rocks

P_R5=42000
P_ESPEJO=41000
MAX_SEVERITY=2
BLOCK_SEC=300
SURICATA_ET=0
