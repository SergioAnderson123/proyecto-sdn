        <mxCell id="c118" parent="1" style="rounded=1;html=1;fillColor=#000000;fontColor=#FFFFFF;fontSize=8;fontStyle=1;strokeColor=#000000;arcSize=30;whiteSpace=nowrap;spacing=0;" value="ens3" vertex="1">
