# Unidad Organizacional para Usuarios

dn: ou=users,dc=example,dc=org
objectClass: organizationalUnit
ou: users

# Unidad Organizacional para Grupos

dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
ou: groups

# Organizacional para Dispositivos

dn: ou=devices,dc=example,dc=org
objectClass: organizationalUnit
ou: devices

# --------------------------------- Usuarios --------------------------------- #
# Profesores: cuentas PERSONALES. Entran por el portal cautivo y, con su propio usuario y contrasena, suben de Alumno a Docente un
# equipo que ya esta autenticado por 802.1X como Alumno (tabla `ascenso` de R2/policy/policy.yaml). Por eso NO llevan MAC, switch ni
# puerto (description, physicalDeliveryOfficeName, roomNumber): se mueven entre equipos y el atado al equipo lo lleva el certificado
# del equipo (rol Alumno). Si se prueba su certificado por 802.1X en un host, `ldap-ubicacion.sh fijar profesor01` le pone esos tres
# datos desde lo que ve ONOS (y `liberar` los quita). El rol JP (hibrido) no se usa: quien ejerce de JP entra con una cuenta de profesor.

dn: uid=profesor01,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: profesor01
sn: Profesor
cn: profesor01@example.org
mail: profesor01@example.org
userPassword: password123
departmentNumber: 3

dn: uid=profesor02,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: profesor02
sn: Profesor
cn: profesor02@example.org
mail: profesor02@example.org
userPassword: password123
departmentNumber: 3

# Alumnos. En la prueba hacen de IDENTIDAD DEL EQUIPO con rol Alumno (en el campus serian PC1-V303-Alumno, etc.): cada uno se ata a la MAC,
# el switch y el puerto de su equipo (valores de Mininet; en VNRT los fija `ldap-ubicacion.sh fijar`).

dn: uid=alumno01,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: alumno01
sn: Alumno
cn: alumno01@example.org
mail: alumno01@example.org
userPassword: password123
description: 00:00:00:00:00:21
physicalDeliveryOfficeName: of:0000000000000001
roomNumber: 2
departmentNumber: 2

dn: uid=alumno02,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: alumno02
sn: Alumno
cn: alumno02@example.org
mail: alumno02@example.org
userPassword: password123
description: 00:00:00:00:00:22
physicalDeliveryOfficeName: of:0000000000000001
roomNumber: 2
departmentNumber: 2

dn: uid=alumno03,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: alumno03
sn: Alumno
cn: alumno03@example.org
mail: alumno03@example.org
userPassword: password123
description: 00:00:00:00:00:23
physicalDeliveryOfficeName: of:0000000000000001
roomNumber: 2
departmentNumber: 2

# Soporte Tecnico

dn: uid=support01,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: support01
sn: Support
cn: support01@example.org
mail: support01@example.org
userPassword: password123
description: 00:00:00:00:00:31
physicalDeliveryOfficeName: of:0000000000000001
roomNumber: 3
departmentNumber: 1

# ---------------------------------- Grupos ---------------------------------- #
# Grupo de Profesores

dn: cn=profesor,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: profesor
member: uid=profesor01,ou=users,dc=example,dc=org
member: uid=profesor02,ou=users,dc=example,dc=org

# Grupo de Alumnos

dn: cn=alumno,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: alumno
member: uid=alumno01,ou=users,dc=example,dc=org
member: uid=alumno02,ou=users,dc=example,dc=org
member: uid=alumno03,ou=users,dc=example,dc=org

# Grupo de Soporte Tecnico

dn: cn=soporteTI,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: soporteTI
member: uid=support01,ou=users,dc=example,dc=org

# Invitados (entran por el portal cautivo; sin MAC ni puerto asignados)

dn: uid=guest01,ou=users,dc=example,dc=org
objectClass: inetOrgPerson
uid: guest01
sn: Invitado
cn: guest01@example.org
mail: guest01@example.org
userPassword: guest123

# Grupo de Invitados

dn: cn=invitado,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: invitado
member: uid=guest01,ou=users,dc=example,dc=org
