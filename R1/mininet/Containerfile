FROM fedora:latest

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN dnf copr enable -y varlad/zellij && \
    dnf -y install \
        git \
        wget \
        python3 \
        openvswitch \
        mininet \
        net-tools \
        iproute \
        iputils \
        neovim \
        zellij \
        wpa_supplicant \
        findutils && \
    dnf clean all

WORKDIR /root

COPY start-ovs.sh /root/start-ovs.sh
COPY init-onos.sh /root/init-onos.sh

RUN sed -i 's/\r$//' /root/start-ovs.sh /root/init-onos.sh \
    && chmod +x /root/start-ovs.sh /root/init-onos.sh

CMD ["bash"]
