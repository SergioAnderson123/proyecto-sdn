# Copiar a un archivo protegido (chmod 600); sustituir valores en cada controlador.
# No guardar tokens, certificados ni claves reales en Git.
AGENTE_TOKEN=<secret>
PRESENCIA_TOKEN=<secret>
PORTAL_TOKEN=<secret>
AAA_CACHE_TTL_S=0.05
SESSION_ETCD_ENDPOINTS=https://192.168.201.<node>:12379,https://192.168.201.<peer>:12379
SESSION_CA=/tls/ca.crt
SESSION_CERT=/tls/node.crt
SESSION_KEY=/tls/node.key
SESSION_ETCD_PREFIX=/sdn/mapper/prod
MAPPER_NODE=ctrl-<node>
ONOS_HOST=192.168.201.<node>
ONOS_PORT=8181
ONOS_ENDPOINTS=http://192.168.201.1:8181,http://192.168.201.2:8181,http://192.168.201.3:8181
PYTHONPATH=/app:/r2_policy
R2_MAB_URL=http://192.168.201.1:5001
HA_MAINTENANCE=1

# Credenciales requeridas: completar solo en el env-file local protegido, nunca en Git.
ONOS_USER=onos
ONOS_PASSWORD=
LDAP_ADMIN_DN=cn=admin,dc=example,dc=org
LDAP_ADMIN_PASSWORD=
