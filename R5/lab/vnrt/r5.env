# Variables de R5 para VNRT (se cargan con: set -a; . ~/r5/r5.env; set +a)
export R5_DIR=$HOME/r5
export VNRT=1
export ONOS_URL=http://127.0.0.1:8181/onos/v1
export ONOS_USER=onos
export ONOS_PASS=rocks
export APP_ID=org.campus.r5
export CORE_DEVICE=of:0000a223f2c04547
export PUERTO_UPLINK=3
export PUERTO_IDS=1
export ESPEJO_HOME_NET=10.0.0.0/30
export ESPEJO_RED_EXTERNA=10.0.0.64/26
export HOME_NET=10.0.0.0/30
export LISTA_BLANCA=10.0.0.1/32
export P_R5=42000
export MAX_SEVERITY=2
export BLOCK_SEC=300
export POLL_SEC=0.05
export EVE_PATH=$HOME/r5/log/eve-alerts.json
export STATE_PATH=$HOME/r5/state/state.json
export LOG_R5=$HOME/r5/log
export INTEG_LOG=$HOME/r5/log/integrador.log
export SURI_LOG=$HOME/r5/log
export EVID_DIR=$HOME/r5/evidencia
export SRV_IP=10.0.0.1
export IDS_MAC=fa:16:3e:07:e8:61
