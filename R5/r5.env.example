# Configuración de R5 (integrador M09 y scripts de lab/). Copiar a .env y completar.
# HOME_NET debe ser igual al HOME_NET de suricata.yaml.

ONOS_URL=http://localhost:8181/onos/v1
ONOS_USER=onos
ONOS_PASS=

EVE_PATH=/var/log/suricata/eve-alerts.json
STATE_PATH=/var/lib/integrador/state.json

HOME_NET=10.0.0.0/24
LISTA_BLANCA=10.0.0.99/32,10.0.0.10/32
CORE_DEVICE=of:0000000000000001
APP_ID=org.campus.r5

# Banda de prioridad de R5: 41000-44999 (sobre la sesión de R2, 40001; bajo R1, 45000)
P_R5=42000
MAX_SEVERITY=2
BLOCK_SEC=300
POLL_SEC=0.05
