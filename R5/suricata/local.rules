alert tcp any any -> $HOME_NET any (msg:"LOCAL Port scan SYN"; flags:S; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:9000002; rev:1; priority:2;)
alert tcp any any -> $HOME_NET 80 (msg:"LOCAL SYN flood"; flags:S; detection_filter:track by_src, count 200, seconds 2; classtype:attempted-dos; sid:9000003; rev:1; priority:1;)
alert http any any -> $HOME_NET any (msg:"LOCAL Herramienta de escaneo web (User-Agent)"; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000010; rev:1; priority:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL Prueba C2 interno (cabecera X-R5-TEST-C2)"; http.header; content:"X-R5-TEST-C2"; classtype:trojan-activity; sid:9000011; rev:1; priority:1;)
alert udp $HOME_NET any -> $HOME_NET any (msg:"LOCAL R4 Inundacion UDP interna"; detection_filter:track by_src, count 300, seconds 2; classtype:attempted-dos; sid:9000020; rev:1; priority:1;)
alert icmp $HOME_NET any -> $HOME_NET any (msg:"LOCAL R4 Inundacion ICMP interna"; itype:8; detection_filter:track by_src, count 200, seconds 2; classtype:attempted-dos; sid:9000021; rev:1; priority:1;)
