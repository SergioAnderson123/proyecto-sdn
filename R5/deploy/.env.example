# Ajustes de UN sensor IDS de R5 (VM nodo-sec-1 o nodo-sec-2). Copiar a R5/deploy/.env y ajustar (no se versiona).
# Lo compartido entre sensores (nodos ONOS, cores, redes, MAC de cada NIC) va en R5/deploy/topologia.yaml.

SENSOR=nodo-sec-1                 # nombre de ESTE sensor: debe estar en `sensores` de topologia.yaml (nodo-sec-1 o nodo-sec-2)
IDS_IFACES=ens4,ens5              # NIC de espejo de este sensor, una por core (ens3 es la de gestión). Ver macs.sh

ONOS_USER=onos
ONOS_PASS=rocks

P_R5=42000                        # DROP de R5; banda 41000-44999 (sobre la sesión R2 40001, bajo R1 45000)
P_ESPEJO=41000                    # espejo en los cores: sobre la sesión y los puertos de confianza de R2 (ver R5/deploy/prioridades.yaml)
MAX_SEVERITY=2
BLOCK_SEC=300
SURICATA_ET=0                     # 1: descargar ET Open con suricata-update (~50 mil reglas; el informe previo prevé 4 vCPU y 8 GB por sensor)
