# Variables comunes de despliegue en VNRT. Copiar a deploy/.env y ajustar (deploy/.env no se versiona).

# --- VM Controller ---
CONTROLLER_IP=192.168.0.10        # red de gestion (roja); los switches abren OpenFlow contra CONTROLLER_IP:6653
ONOS_USER=onos
ONOS_PASS=rocks

# --- VM IDS (R5) ---
IDS_IFACE=ens4                    # interfaz conectada al puerto de espejo del Core
# IDS_MAC=                        # si se omite, ids/up.sh la lee de /sys/class/net/$IDS_IFACE/address
HOME_NET=10.0.0.0/30              # prefijos del campus (coma como separador); debe coincidir con ESPEJO_HOME_NET
LISTA_BLANCA=10.0.0.1/32          # IP que el integrador nunca bloquea (servidores, DNS, gestion)
SURICATA_ET=0                     # 1: descargar ET Open con suricata-update (necesita ~2-3 GB de RAM libres)

# --- Espejo selectivo en el Core (R5) ---
CORE_DEVICE=of:0000a223f2c04547   # deviceId del Core en ONOS (GET /onos/v1/devices)
PUERTO_UPLINK=3                   # puerto del Core hacia el exterior
PUERTO_IDS=1                      # puerto del Core hacia la VM IDS
ESPEJO_HOME_NET=10.0.0.0/30
ESPEJO_RED_EXTERNA=10.0.0.64/26

# --- Integrador M09 ---
P_R5=42000                        # banda R5: 41000-44999 (sobre la sesion R2 40001, bajo R1 45000)
MAX_SEVERITY=2
BLOCK_SEC=300
