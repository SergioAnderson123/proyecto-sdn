<?xml version="1.0" encoding="UTF-8"?>
<!-- App de ONOS "Gateway ARP": instala (como flujos PROPIOS de ONOS, no "extraños") los flujos estáticos con los que cada switch de acceso contesta el ARP del gateway virtual de su subred
     (capa 3 por subredes; ver docs/DISENO_CAPA3.md). Compilar: ver README.md (en Docker, con Maven y JDK 11). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.onosproject</groupId>
        <artifactId>onos-dependencies</artifactId>
        <version>2.7.0</version>
    </parent>

    <groupId>org.campus</groupId>
    <artifactId>campus-dhcp</artifactId>
    <version>1.0.0</version>
    <packaging>bundle</packaging>

    <description>Servidor DHCP por subred (ambito segun el switch y el puerto), con limites contra el agotamiento de direcciones, que avisa a ONOS de la IP de cada host</description>
    <url>https://github.com/SergioAnderson123/proyecto-sdn</url>

    <properties>
        <onos.version>2.7.0</onos.version>
        <onos.app.name>org.campus.dhcp</onos.app.name>
        <onos.app.title>DHCP por subred (capa 3)</onos.app.title>
        <onos.app.origin>PUCP TEL354 Grupo 4</onos.app.origin>
        <onos.app.category>Utility</onos.app.category>
        <onos.app.url>https://github.com/SergioAnderson123/proyecto-sdn</onos.app.url>
        <onos.app.readme>DHCP por subred para la capa 3 del campus: ambito por switch y puerto, cuotas y limites de tasa contra el agotamiento, y registro de la IP en ONOS.</onos.app.readme>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onos-api</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onlab-osgi</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.onosproject</groupId>
            <artifactId>onlab-misc</artifactId>
            <version>${onos.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.4.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.30</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.onosproject</groupId>
                <artifactId>onos-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
